# Copiez ce fichier sous le nom .env et renseignez votre clé Gemini.
GEMINI_API_KEY=votre_cle_gemini_ici

# Obligatoire en production : une valeur longue, aléatoire et privée.
FLASK_SECRET_KEY=remplacez_cette_valeur_par_une_cle_aleatoire

# À définir sur 1 dans Render (site servi en HTTPS).
SESSION_COOKIE_SECURE=1

# PostgreSQL Render. En local, Dashle crée automatiquement dashle.db.
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote:5432/dashle

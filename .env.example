# Copiez ce fichier sous le nom .env et renseignez votre clé Gemini.
GEMINI_API_KEY=votre_cle_gemini_ici

# Obligatoire en production : une valeur longue, aléatoire et privée.
FLASK_SECRET_KEY=remplacez_cette_valeur_par_une_cle_aleatoire

# À définir sur 1 dans Render (site servi en HTTPS).
SESSION_COOKIE_SECURE=1

# PostgreSQL Render. En local, Dashle crée automatiquement dashle.db.
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote:5432/dashle


# PayDunya — utiliser "test" en développement/sandbox et "live" uniquement en production.
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=votre_master_key_paydunya
PAYDUNYA_PRIVATE_KEY=votre_private_key_paydunya
PAYDUNYA_TOKEN=votre_token_paydunya
PAYDUNYA_STORE_NAME=Dashle
PAYDUNYA_CURRENCY=XOF


# Connecteurs externes Dashle (aucune valeur réelle dans le dépôt)
DASHLE_CONNECTOR_FERNET_KEY=
DASHLE_PUBLIC_URL=https://dashle.onrender.com
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
ANDROID_RELEASE_CERT_SHA256=

CONNECTORS_ENABLED=0
CONNECTOR_GITHUB_ENABLED=0
CONNECTOR_GOOGLE_ENABLED=0
CONNECTOR_NOTION_ENABLED=0
CONNECTOR_RENDER_ENABLED=0
